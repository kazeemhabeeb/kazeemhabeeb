# TrustFeed public web root (§3.8)

# Never list a folder's files when it has no index page.
Options -Indexes

# Refuse hidden files (.htaccess, .git...) and leftover backup or database files.
<FilesMatch "(^\.|~$|\.(bak|old|orig|sql|log|ini|sh)$)">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>

# HTTPS is enforced by the PHP pages themselves (FORCE_HTTPS in config.php), which also works on
# Nginx. On Apache this rule moves the static files (CSS, JS, images) to https:// as well.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
</IfModule>
